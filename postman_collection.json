              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userType\": \"student\",\n  \"studentId\": \"12345\",\n  \"schoolName\": \"Test University\",\n  \"fieldOfStudy\": \"Computer Science\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
